# ─────────────────────────────────────────────────────────────────────────────
# Local-first testing config
#
# Copy this to `.env.local` (gitignored) to run CatCoder with NO external
# services. Auth, profiles, progress, and the leaderboard are all backed by
# your browser's localStorage. Sign up with any email + password and start
# testing immediately.
# ─────────────────────────────────────────────────────────────────────────────

# Force the in-browser local backend. Remove this (or set to "supabase") and
# provide real credentials below to talk to a real Supabase project.
VITE_BACKEND=local

# Storage encryption key. Any non-empty value works in local/dev mode.
VITE_STORAGE_ENCRYPTION_KEY=local-dev-testing-key

# AI is off by default. The local backend has no AI proxy, so leave disabled
# unless you point VITE_AI_PROXY_URL at a running proxy.
VITE_AI_ENABLED=false

# ── Optional: real Supabase (ignored while VITE_BACKEND=local) ───────────────
# VITE_SUPABASE_URL=https://your-project-id.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key-here
