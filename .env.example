# ─────────────────────────────────────────────────────────────────────────────
# CatCoder environment configuration
#
# All VITE_* variables are inlined into the client bundle at build time. Treat
# them as PUBLIC. Anything that must stay private (database tokens, API keys,
# server secrets) belongs in a server-side environment such as Cloudflare
# Worker secrets — never with the VITE_ prefix.
# ─────────────────────────────────────────────────────────────────────────────

# ── Backend selection ───────────────────────────────────────────────────────
# local    -> in-browser localStorage (no setup, testing only)
# turso    -> Cloudflare Worker + Turso via /api/* (see README "Deploy to Cloudflare")
# supabase -> real Supabase project
# (unset)  -> auto: supabase if credentials below are valid, else local
VITE_BACKEND=local

# ── Supabase (only for VITE_BACKEND=supabase) ───────────────────────────────
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Turso backend (only for VITE_BACKEND=turso) ─────────────────────────────
# The SPA calls same-origin /api/* by default. Override only if the API is on
# a different origin than the static site.
# VITE_API_BASE_URL=https://catcoder.your-subdomain.workers.dev
# Worker-side (NOT VITE_): set in wrangler.toml [vars] and `wrangler secret put`
#   LIBSQL_DB_URL, LIBSQL_DB_AUTH_TOKEN, AUTH_SECRET

# ── AI proxy (optional) ─────────────────────────────────────────────────────
VITE_AI_ENABLED=false
# VITE_AI_PROXY_URL=
VITE_OPENAI_MODEL=gpt-4o-mini

# ── Local storage encryption ────────────────────────────────────────────────
# REQUIRED in production. Use a 32+ random bytes value (e.g. `openssl rand -hex 32`).
VITE_STORAGE_ENCRYPTION_KEY=your-secure-random-key-here

# ── Mail credentials for CI notifications (server-only, no VITE_ prefix) ────
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password
