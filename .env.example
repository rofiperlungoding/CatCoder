# ─────────────────────────────────────────────────────────────────────────────
# CatCoder environment configuration
#
# All VITE_* variables are inlined into the client bundle at build time. Treat
# them as PUBLIC. Anything that must stay private (third-party API keys, server
# secrets) belongs in a server-side environment such as Supabase Edge Function
# secrets or Netlify build env vars without the VITE_ prefix.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (required for auth + persistence) ──────────────────────────────
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── AI proxy (optional) ─────────────────────────────────────────────────────
# Toggle the AI mentor features in the UI.
VITE_AI_ENABLED=false
# Override the proxy URL. When unset, falls back to the Supabase Edge Function
# at `${VITE_SUPABASE_URL}/functions/v1/ai-proxy`.
# VITE_AI_PROXY_URL=
# Default model identifier forwarded to the proxy.
VITE_OPENAI_MODEL=gpt-4o-mini

# ── Local storage encryption ────────────────────────────────────────────────
# REQUIRED in production. Use a 32+ random bytes value (e.g. `openssl rand -hex 32`).
# When missing, secureStorage falls back to a public dev key only in DEV mode
# and refuses to start in PROD.
VITE_STORAGE_ENCRYPTION_KEY=your-secure-random-key-here

# ── Mail credentials for CI notifications (server-only, no VITE_ prefix) ────
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password

# ── Server-only secrets (DO NOT prefix with VITE_) ──────────────────────────
# Stored on the AI proxy / edge function — NEVER ship these to the browser.
# OPENAI_API_KEY=sk-...
