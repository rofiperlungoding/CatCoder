[TEMPLATE]
# CatCoder Bug Arena environment configuration
#
# Worker bindings are set in wrangler.toml [vars] (non-secret) and via
# `npx wrangler secret put <NAME>` (secret). For local Worker dev they are read
# from worker/.dev.vars. No secret is ever VITE prefixed.
#
# Client variables are inlined into the SPA bundle at build time. Treat every
# VITE_ value as PUBLIC.

# ===== Worker bindings (server only) =====

# Turso libSQL database URL, e.g. libsql://your-db.turso.io
LIBSQL_DB_URL=libsql://your-db.turso.io

# Turso auth token. Secret.
LIBSQL_DB_AUTH_TOKEN=your-turso-auth-token

# Secret used to scope sessions and derive PBKDF2 keys. Secret.
AUTH_SECRET=your-auth-secret

# Mistral API key, used only by the Worker to judge hypotheses. Secret.
MISTRAL_API_KEY=your-mistral-api-key

# Cloudflare Turnstile secret key, used by the Worker to verify tokens. Secret.
TURNSTILE_SECRET=your-turnstile-secret

# Comma-separated CORS allowlist. Every origin serving the SPA must appear
# here, e.g. https://catcoder.online,https://www.catcoder.online
ALLOWED_ORIGINS=http://localhost:8787

# RATE_LIMIT is a Workers KV namespace binding declared in wrangler.toml.
# ASSETS is the static assets Fetcher binding declared in wrangler.toml.

# ===== Client variables (safe to expose, VITE prefixed) =====

# Cloudflare Turnstile site key.
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Optional. Override only if the API is on a different origin than the SPA.
# VITE_API_BASE_URL=https://catcoder.your-subdomain.workers.dev
