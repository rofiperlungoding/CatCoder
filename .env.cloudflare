# Build-mode env for Cloudflare/Turso.
# Used by `vite build --mode cloudflare` (npm run cf:build / cf:dev / cf:deploy).
# No secrets here — the Turso token lives in Worker secrets / .dev.vars.

VITE_BACKEND=turso

# Client-side localStorage obfuscation key (inlined into the bundle by design;
# not a real server secret). Override via .env.cloudflare.local if you want.
VITE_STORAGE_ENCRYPTION_KEY=catcoder-cloudflare-storage-key

VITE_AI_ENABLED=false
